# ⚠️ IMPORTANT: This token is also used in davidsklad.ru server/parts/02f-telegram-news.js
# for polling channel posts. Running both simultaneously causes getUpdates offset conflicts.
# Solution: either set MAGICVIBES_BOT_USE_WEBHOOK=true here, or move 02f-telegram-news.js
# to use a dedicated news bot token.
TELEGRAM_BOT_TOKEN=8691183442:AAFoWdQuuNHwYdFUAoJmv3ipvFOVnRkJ83c

# The magicvibes.ru shop API base (served from davidsklad.ru)
MAGICVIBES_API_BASE=https://magicvibes.ru

# Comma-separated Telegram user IDs for admin commands (broadcast, etc.)
ADMIN_TELEGRAM_IDS=

# Webhook mode (recommended to avoid conflict with 02f-telegram-news.js polling)
# Set to true and configure WEBHOOK_URL + WEBHOOK_PORT
MAGICVIBES_BOT_USE_WEBHOOK=false
WEBHOOK_URL=https://YOUR_NL_SERVER:8443
WEBHOOK_PORT=8443
WEBHOOK_SECRET=

NODE_ENV=production
